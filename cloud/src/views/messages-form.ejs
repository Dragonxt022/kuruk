<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include('partials/theme-init') %>
  <title>Kuruk Cloud — <%= msg ? 'Editar mensagem' : 'Nova mensagem' %></title>
  <link rel="icon" type="image/png" href="/logo_kuruk-icon.png">
  <%- include('partials/styles') %>
  <style>
    .mf-layout { display: grid; grid-template-columns: minmax(0, 1fr) 350px; gap: 18px; align-items: start; }
    .mf-main, .mf-aside { display: grid; gap: 18px; min-width: 0; }
    .mf-card { padding: 22px 24px; }
    .mf-aside { position: sticky; top: 18px; }
    @media (max-width: 1080px) {
      .mf-layout { grid-template-columns: 1fr; }
      .mf-aside { position: static; }
    }

    .mf-card .form-section-head { margin-bottom: 18px; }
    .mf-card .form-section-head h3 { font-size: 0.98rem; }
    .mf-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; }
    .mf-row > * { min-width: 0; }
    @media (max-width: 620px) { .mf-row { grid-template-columns: 1fr; } }
    .mf-label-row { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
    .mf-label-row .mf-count { font-size: 11px; font-weight: 500; color: var(--muted); }
    .mf-card input[type='text'],
    .mf-card select { margin-bottom: 0; }
    .mf-card .field-hint { margin: 6px 0 0; }

    /* Prioridade — um cartão clicável, não um checkbox solto no meio do formulário. */
    .mf-check {
      display: flex; gap: 10px; align-items: flex-start;
      margin: 0; padding: 10px 12px; cursor: pointer; font-weight: 500;
      border: 1.5px solid var(--border-light); border-radius: 10px;
      background: var(--surface); transition: border-color .15s, background .15s;
    }
    .mf-check:hover { border-color: var(--muted); }
    .mf-check input { width: auto; margin: 2px 0 0; flex: none; }
    .mf-check small { display: block; font-weight: 500; font-size: 11.5px; color: var(--muted); margin-top: 2px; }
    .mf-check:has(input:checked) { border-color: #f59e0b; background: #fffbeb; }
    :root[data-theme='dark'] .mf-check:has(input:checked) { background: rgba(245, 158, 11, .12); }

    /* Destino */
    .mf-radio {
      display: flex; gap: 10px; align-items: flex-start;
      margin: 0 0 8px; padding: 10px 12px; cursor: pointer; font-weight: 500;
      border: 1.5px solid var(--border-light); border-radius: 10px;
      background: var(--surface); transition: border-color .15s, background .15s;
    }
    .mf-radio:last-of-type { margin-bottom: 0; }
    .mf-radio:hover { border-color: var(--muted); }
    .mf-radio input { width: auto; margin: 2px 0 0; flex: none; }
    .mf-radio small { display: block; font-weight: 500; font-size: 11.5px; color: var(--muted); margin-top: 2px; }
    .mf-radio:has(input:checked) { border-color: var(--primary); background: var(--primary-soft); }
    #f-targets-wrap { margin-top: 12px; }
    .mf-search {
      display: block; width: 100%; padding: 9px 12px; margin: 0 0 8px;
      border: 1px solid var(--border); border-radius: 8px;
      background: var(--surface); color: var(--text);
      font-family: inherit; font-size: 0.9rem;
    }
    .mf-search:focus { outline: 2px solid var(--primary-soft); border-color: var(--primary); }
    .mf-target-list {
      max-height: 230px; overflow: auto; overscroll-behavior: contain;
      border: 1px solid var(--border); border-radius: 10px; background: var(--surface);
      padding: 6px;
    }
    .mf-target-item {
      display: flex; align-items: center; gap: 9px;
      margin: 0; padding: 8px 9px; border-radius: 8px;
      font-size: 13px; font-weight: 500; cursor: pointer;
    }
    .mf-target-item:hover { background: var(--surface-hover); }
    .mf-target-item input { width: auto; margin: 0; flex: none; }
    .mf-target-item span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mf-target-empty { padding: 14px 10px; text-align: center; font-size: 12.5px; color: var(--muted); }

    /* Imagem de destaque */
    .mf-image-empty {
      display: flex; flex-direction: column; align-items: center; gap: 8px;
      padding: 22px 16px; text-align: center;
      border: 1.5px dashed var(--border); border-radius: 12px;
      background: var(--surface-hover); transition: border-color .15s, background .15s;
    }
    .mf-image-empty.drag { border-color: var(--primary); background: var(--primary-soft); }
    .mf-image-empty svg { width: 30px; height: 30px; color: var(--muted); flex: none; }
    .mf-image-empty p { margin: 0; font-weight: 600; font-size: 13px; }
    .mf-image-empty .mf-image-name { font-size: 11.5px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; max-width: 100%; white-space: nowrap; }
    .mf-image-preview img {
      display: block; width: 100%; height: 190px; object-fit: cover;
      border-radius: 12px; border: 1px solid var(--border-light); background: var(--surface-hover);
    }
    .mf-image-actions { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
    .mf-image-actions .btn { flex: 1; justify-content: center; }

    /* Editor */
    .editor-toolbar {
      display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 8px;
      padding: 6px; border: 1px solid var(--border-light); border-radius: 10px;
      background: var(--surface-hover);
    }
    .editor-toolbar button { min-width: 34px; padding: 5px 9px; font-size: 12.5px; }
    .editor-toolbar .tb-sep { width: 1px; align-self: stretch; background: var(--border-light); margin: 2px 3px; }
    .editor-area {
      min-height: 300px; max-height: 60vh; overflow-y: auto;
      border: 1.5px solid var(--border); border-radius: 12px;
      padding: 14px 16px; background: var(--surface);
      font-size: 0.94rem; line-height: 1.6;
    }
    .editor-area:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-soft); }
    .editor-area:empty::before { content: attr(data-placeholder); color: var(--muted); pointer-events: none; }
    .editor-area h1 { font-size: 1.5rem; line-height: 1.25; margin: .2em 0 .5em; }
    .editor-area h2 { font-size: 1.25rem; line-height: 1.3; margin: .2em 0 .5em; }
    .editor-area h3 { font-size: 1.08rem; line-height: 1.35; margin: .2em 0 .5em; }
    .editor-area p { margin: .55em 0; }
    .editor-area ul, .editor-area ol { padding-left: 1.4rem; margin: .55em 0; }
    .editor-area li { margin: .2em 0; }
    .editor-area a { color: var(--primary); text-decoration: underline; }
    .editor-area blockquote {
      margin: .7em 0; padding: .45em .9em; border-left: 3px solid var(--primary);
      background: var(--surface-hover); border-radius: 0 8px 8px 0;
    }
    .editor-area img { max-width: 100%; max-height: 280px; object-fit: contain; border-radius: 10px; }
    .editor-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
    .editor-foot .field-hint { margin: 0; }
    .editor-foot .mf-count { font-size: 11.5px; color: var(--muted); white-space: nowrap; }

    /* Prévia */
    .mf-preview {
      border: 1px solid var(--border-light); border-radius: 12px;
      padding: 14px; background: var(--surface-hover);
    }
    .mf-preview h3 { margin: 8px 0 0; font-size: 15px; line-height: 1.35; }
    .mf-preview .mf-preview-sub { margin: 4px 0 0; font-size: 12.5px; color: var(--muted); }
    .mf-preview img { width: 100%; max-height: 140px; object-fit: cover; border-radius: 9px; margin-top: 10px; }
    .mf-preview-body { margin-top: 8px; font-size: 12.5px; line-height: 1.6; overflow-wrap: anywhere; }
    .mf-preview-body h1, .mf-preview-body h2, .mf-preview-body h3 { font-size: 1rem; margin: .7em 0 .35em; }
    .mf-preview-body p { margin: .5em 0; }
    .mf-preview-body ul, .mf-preview-body ol { padding-left: 1.25rem; margin: .5em 0; }
    .mf-preview-body a { color: var(--primary); text-decoration: underline; }
    .mf-preview-body blockquote { margin: .6em 0; padding: .4em .7em; border-left: 3px solid var(--primary); }
    .mf-preview-body img { max-width: 100%; max-height: 160px; object-fit: contain; border-radius: 8px; margin: .5em 0; }
    .mf-preview-empty { margin: 8px 0 0; font-size: 12px; color: var(--muted); }

    .mf-actions {
      display: flex; gap: 10px; align-items: center;
      padding: 12px; border: 1px solid var(--border-light); border-radius: 12px;
      background: var(--surface);
      box-shadow: var(--shadow-sm);
    }
    .mf-actions .btn { flex: 1; justify-content: center; }
  </style>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'messages' }) %>
    <main class="content">
      <%- include('partials/navbar', { active: 'messages' }) %>

      <div class="page">
        <div class="page-header">
          <div>
            <p class="breadcrumb">Mensagens</p>
            <h1><%= msg ? 'Editar mensagem' : 'Nova mensagem' %></h1>
            <p class="page-subtitle">Escreva o comunicado e veja à direita como ele vai aparecer no aplicativo da loja.</p>
          </div>
          <a class="btn secondary" href="/admin/messages">Voltar</a>
        </div>

        <div id="f-error" class="error-banner" style="display:none"></div>

        <div class="mf-layout">
          <div class="mf-main">
            <div class="card mf-card">
              <div class="form-section-head">
                <span class="step-badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
                </span>
                <div>
                  <h3>Conteúdo</h3>
                  <p>O título aparece na lista; o subtítulo é uma linha de apoio opcional.</p>
                </div>
              </div>

              <div class="mf-label-row">
                <label for="f-title">Título</label>
                <span class="mf-count" id="f-title-count">0/200</span>
              </div>
              <input type="text" id="f-title" maxlength="200" placeholder="Ex.: Novidade: acompanhe a loja pelo celular">

              <div class="mf-label-row" style="margin-top:16px">
                <label for="f-subtitle">Subtítulo <span class="muted" style="font-weight:500">(opcional)</span></label>
                <span class="mf-count" id="f-subtitle-count">0/300</span>
              </div>
              <input type="text" id="f-subtitle" maxlength="300" placeholder="Uma linha de apoio">

              <div class="mf-row" style="margin-top:16px">
                <div>
                  <label for="f-category">Categoria</label>
                  <select id="f-category">
                    <% categories.forEach(function(c) { %>
                      <option value="<%= c %>"><%= c.charAt(0).toUpperCase() + c.slice(1) %></option>
                    <% }); %>
                  </select>
                </div>
                <div>
                  <label>Prioridade</label>
                  <label class="mf-check" style="min-height:40px">
                    <input type="checkbox" id="f-urgent">
                    <span>
                      Urgente
                      <small>Abre como aviso na tela inicial da loja.</small>
                    </span>
                  </label>
                </div>
              </div>
            </div>

            <div class="card mf-card">
              <div class="form-section-head">
                <span class="step-badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                </span>
                <div>
                  <h3>Mensagem</h3>
                  <p>Use negrito, títulos e listas — a formatação é a mesma no aplicativo.</p>
                </div>
              </div>

              <div class="editor-toolbar" role="toolbar" aria-label="Formatação da mensagem">
                <button type="button" class="btn secondary small" data-cmd="bold" title="Negrito (Ctrl+B)"><b>B</b></button>
                <button type="button" class="btn secondary small" data-cmd="italic" title="Itálico (Ctrl+I)"><i>I</i></button>
                <button type="button" class="btn secondary small" data-cmd="underline" title="Sublinhado (Ctrl+U)"><u>U</u></button>
                <span class="tb-sep"></span>
                <button type="button" class="btn secondary small" data-block="H2" title="Título de seção">Título</button>
                <button type="button" class="btn secondary small" data-block="H3" title="Subtítulo de seção">Subtítulo</button>
                <button type="button" class="btn secondary small" data-block="P" title="Texto normal">Texto</button>
                <span class="tb-sep"></span>
                <button type="button" class="btn secondary small" data-cmd="insertUnorderedList" title="Lista com marcadores">• Lista</button>
                <button type="button" class="btn secondary small" data-cmd="insertOrderedList" title="Lista numerada">1. Lista</button>
                <button type="button" class="btn secondary small" data-link="1" title="Inserir link">Link</button>
                <span class="tb-sep"></span>
                <button type="button" class="btn secondary small" data-cmd="removeFormat" title="Limpar formatação">Limpar</button>
              </div>
              <div class="editor-area" id="f-editor" contenteditable="true"
                   data-placeholder="Escreva aqui o conteúdo da mensagem…" role="textbox" aria-multiline="true"></div>
              <div class="editor-foot">
                <p class="field-hint">Dica: selecione o texto antes de aplicar negrito, título ou link.</p>
                <span class="mf-count" id="f-body-count">0 palavras</span>
              </div>
            </div>
          </div>

          <aside class="mf-aside">
            <div class="card mf-card">
              <div class="form-section-head">
                <span class="step-badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11 22 2l-9 19-2-8-8-2Z"/></svg>
                </span>
                <div>
                  <h3>Destino</h3>
                  <p>Para quais lojas a mensagem será enviada.</p>
                </div>
              </div>

              <label class="mf-radio">
                <input type="radio" name="target" id="f-all" value="all" checked onchange="toggleTargets()">
                <span>Todas as empresas<small>Inclui lojas novas que entrarem depois.</small></span>
              </label>
              <label class="mf-radio">
                <input type="radio" name="target" id="f-specific" value="specific" onchange="toggleTargets()">
                <span>Empresas específicas<small>Escolha uma ou mais lojas abaixo.</small></span>
              </label>

              <div id="f-targets-wrap" style="display:none">
                <input type="search" class="mf-search" id="f-target-search" placeholder="Buscar empresa…" autocomplete="off">
                <div class="mf-target-list" id="f-target-list"></div>
                <p class="field-hint" id="f-target-count">Nenhuma empresa selecionada.</p>
              </div>
            </div>

            <div class="card mf-card">
              <div class="form-section-head">
                <span class="step-badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                </span>
                <div>
                  <h3>Imagem de destaque</h3>
                  <p>Opcional. Aparece no topo da mensagem.</p>
                </div>
              </div>

              <div class="mf-image-empty" id="f-image-empty">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                <p>Arraste uma imagem ou escolha do computador</p>
                <button type="button" class="btn secondary small" id="f-pick-btn">Escolher imagem</button>
                <span class="mf-image-name" id="f-image-name">Nenhum arquivo escolhido</span>
              </div>

              <div class="mf-image-preview" id="f-image-preview" style="display:none">
                <img id="f-image-img" alt="Prévia da imagem de destaque">
                <div class="mf-image-actions">
                  <button type="button" class="btn secondary small" id="f-change-btn">Trocar</button>
                  <button type="button" class="btn danger small" id="f-remove-image-btn">Remover</button>
                </div>
              </div>

              <input type="file" id="f-image" accept="image/jpeg,image/png,image/webp,image/gif" style="display:none">
              <input type="checkbox" id="f-remove-image" style="display:none">
              <p class="field-hint">JPG, PNG, WEBP ou GIF — até 3MB.</p>
            </div>

            <div class="card mf-card">
              <div class="form-section-head" style="margin-bottom:12px">
                <span class="step-badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                </span>
                <div>
                  <h3>Prévia</h3>
                  <p>Como a loja vai ver na central de mensagens.</p>
                </div>
              </div>
              <div class="mf-preview">
                <span class="badge" id="f-preview-category">Comunicado</span>
                <h3 id="f-preview-title">Título da mensagem</h3>
                <p class="mf-preview-sub" id="f-preview-subtitle" style="display:none"></p>
                <img id="f-preview-image" alt="" style="display:none">
                <div class="mf-preview-body" id="f-preview-body"></div>
                <p class="mf-preview-empty" id="f-preview-empty">Comece a escrever para ver a prévia.</p>
              </div>
            </div>

            <div class="mf-actions">
              <button type="button" class="btn" id="f-save">Salvar mensagem</button>
              <a class="btn secondary" href="/admin/messages" style="flex:0 0 auto">Cancelar</a>
            </div>
          </aside>
        </div>
      </div>
    </main>
  </div>

  <script>
    var MSG = <%- (msg ? JSON.stringify(msg) : 'null').replace(/</g, '\\u003c') %>;
    var COMPANIES = <%- JSON.stringify(companies.map(function (c) { return { uuid: c.company_uuid, name: c.name || c.company_uuid }; })).replace(/</g, '\\u003c') %>;
    var imageData = null;
    var selectedTargets = {};

    function toggleTargets() {
      var especifico = document.getElementById('f-specific').checked;
      document.getElementById('f-targets-wrap').style.display = especifico ? 'block' : 'none';
      if (especifico) renderTargets();
    }

    function showError(msg) {
      var el = document.getElementById('f-error');
      el.textContent = msg;
      el.style.display = 'block';
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function clearError() {
      document.getElementById('f-error').style.display = 'none';
    }

    // Precisam ser globais: o `onchange="toggleTargets()"` dos radios é chamado no escopo
    // da página, e o toggle chama renderTargets. Presas ao IIFE abaixo, a edição de uma
    // mensagem com empresas específicas morria com "renderTargets is not defined" antes
    // de montar a lista.
    function renderTargets() {
      var list = document.getElementById('f-target-list');
      var q = (document.getElementById('f-target-search').value || '').trim().toLowerCase();
      list.innerHTML = '';
      var found = 0;
      COMPANIES.forEach(function (c) {
        if (q && c.name.toLowerCase().indexOf(q) === -1) return;
        found++;
        var label = document.createElement('label');
        label.className = 'mf-target-item';
        var input = document.createElement('input');
        input.type = 'checkbox';
        input.value = c.uuid;
        input.checked = !!selectedTargets[c.uuid];
        input.addEventListener('change', function () {
          if (input.checked) selectedTargets[c.uuid] = true;
          else delete selectedTargets[c.uuid];
          updateTargetCount();
        });
        var span = document.createElement('span');
        span.textContent = c.name;
        label.appendChild(input);
        label.appendChild(span);
        list.appendChild(label);
      });
      if (!found) {
        var p = document.createElement('p');
        p.className = 'mf-target-empty';
        p.textContent = 'Nenhuma empresa encontrada.';
        list.appendChild(p);
      }
      updateTargetCount();
    }

    function updateTargetCount() {
      var n = Object.keys(selectedTargets).length;
      document.getElementById('f-target-count').textContent = n
        ? n + (n === 1 ? ' empresa selecionada.' : ' empresas selecionadas.')
        : 'Nenhuma empresa selecionada.';
    }

    /**
     * O contenteditable deixa o primeiro texto solto (sem <p>) quando a pessoa começa a
     * digitar num editor vazio. Aqui os nós de texto/inline de topo viram parágrafos para
     * o app renderizar com a mesma margem dos demais.
     */
    function normalizedEditorHtml() {
      var source = document.getElementById('f-editor');
      var clone = document.createElement('div');
      clone.innerHTML = source.innerHTML;
      var blockTags = /^(P|DIV|UL|OL|H1|H2|H3|H4|H5|H6|BLOCKQUOTE|PRE|TABLE|HR|FIGURE)$/;
      var out = document.createElement('div');
      var current = null;
      Array.prototype.slice.call(clone.childNodes).forEach(function (node) {
        var isBlock = node.nodeType === 1 && blockTags.test(node.tagName);
        if (isBlock) {
          current = null;
          out.appendChild(node);
          return;
        }
        if (node.nodeType === 3 && !String(node.textContent || '').trim()) return;
        if (!current) {
          current = document.createElement('p');
          out.appendChild(current);
        }
        current.appendChild(node);
      });
      return out.innerHTML;
    }

    (function () {
      var editor = document.getElementById('f-editor');
      var fileInput = document.getElementById('f-image');
      var removeCheckbox = document.getElementById('f-remove-image');
      var imageEmpty = document.getElementById('f-image-empty');
      var imagePreview = document.getElementById('f-image-preview');
      var imageImg = document.getElementById('f-image-img');
      var imageName = document.getElementById('f-image-name');

      // Cada Enter cria um parágrafo de verdade, não um <div> sem estilo.
      try { document.execCommand('defaultParagraphSeparator', false, 'p'); } catch (e) {}

      document.querySelectorAll('.editor-toolbar button').forEach(function (btn) {
        btn.addEventListener('mousedown', function (e) { e.preventDefault(); });
        btn.addEventListener('click', function () {
          editor.focus();
          if (btn.dataset.block) {
            document.execCommand('formatBlock', false, btn.dataset.block);
          } else if (btn.dataset.link) {
            var url = prompt('Endereço do link (https://…)');
            if (url) document.execCommand('createLink', false, url);
          } else if (btn.dataset.cmd) {
            document.execCommand(btn.dataset.cmd, false, null);
          }
          updatePreview();
        });
      });

      function paintImage(src, name) {
        imageImg.src = src;
        imagePreview.style.display = 'block';
        imageEmpty.style.display = 'none';
        if (name) imageName.textContent = name;
        var prev = document.getElementById('f-preview-image');
        prev.src = src;
        prev.style.display = 'block';
      }

      function paintEmpty() {
        imageImg.removeAttribute('src');
        imagePreview.style.display = 'none';
        imageEmpty.style.display = 'flex';
        imageName.textContent = 'Nenhum arquivo escolhido';
        var prev = document.getElementById('f-preview-image');
        prev.removeAttribute('src');
        prev.style.display = 'none';
      }

      function fileToDataUrl(file) {
        if (!file) return;
        if (!/^image\/(jpeg|png|webp|gif)$/.test(file.type)) {
          showError('Formato não aceito. Use JPG, PNG, WEBP ou GIF.');
          return;
        }
        if (file.size > 3 * 1024 * 1024) {
          showError('Imagem maior que 3MB.');
          fileInput.value = '';
          return;
        }
        clearError();
        imageName.textContent = file.name;
        var reader = new FileReader();
        reader.onload = function () {
          imageData = reader.result;
          removeCheckbox.checked = false;
          paintImage(imageData, file.name);
        };
        reader.readAsDataURL(file);
      }

      fileInput.addEventListener('change', function () { fileToDataUrl(this.files && this.files[0]); });
      document.getElementById('f-pick-btn').addEventListener('click', function () { fileInput.click(); });
      document.getElementById('f-change-btn').addEventListener('click', function () { fileInput.click(); });
      document.getElementById('f-remove-image-btn').addEventListener('click', function () {
        imageData = null;
        if (MSG && MSG.has_image) removeCheckbox.checked = true;
        fileInput.value = '';
        paintEmpty();
      });

      // Arrastar e soltar na área vazia.
      ;['dragenter', 'dragover'].forEach(function (ev) {
        imageEmpty.addEventListener(ev, function (e) { e.preventDefault(); imageEmpty.classList.add('drag'); });
      });
      ;['dragleave', 'drop'].forEach(function (ev) {
        imageEmpty.addEventListener(ev, function (e) { e.preventDefault(); imageEmpty.classList.remove('drag'); });
      });
      imageEmpty.addEventListener('drop', function (e) {
        fileToDataUrl(e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]);
      });

      // ─── Edição / restauração ───
      if (MSG) {
        document.getElementById('f-title').value = MSG.title || '';
        document.getElementById('f-subtitle').value = MSG.subtitle || '';
        document.getElementById('f-category').value = MSG.category || 'comunicado';
        document.getElementById('f-urgent').checked = !!MSG.is_urgent;
        editor.innerHTML = MSG.body_html || '';
        if (MSG.target_all) {
          document.getElementById('f-all').checked = true;
        } else {
          document.getElementById('f-specific').checked = true;
          (MSG.targets || []).forEach(function (uuid) { selectedTargets[uuid] = true; });
        }
        if (MSG.has_image) paintImage('/admin/messages/' + MSG.uuid + '/image');
        toggleTargets();
      }

      document.getElementById('f-save').addEventListener('click', save);

      // ─── Contadores / prévia ao vivo ───
      function updateCounters() {
        var title = document.getElementById('f-title');
        var subtitle = document.getElementById('f-subtitle');
        document.getElementById('f-title-count').textContent = title.value.length + '/200';
        document.getElementById('f-subtitle-count').textContent = subtitle.value.length + '/300';
        var words = (editor.textContent || '').trim().split(/\s+/).filter(Boolean).length;
        document.getElementById('f-body-count').textContent = words + (words === 1 ? ' palavra' : ' palavras');
      }

      function updatePreview() {
        var title = document.getElementById('f-title').value.trim();
        var subtitle = document.getElementById('f-subtitle').value.trim();
        var cat = document.getElementById('f-category');
        var catLabel = cat.options[cat.selectedIndex] ? cat.options[cat.selectedIndex].text : 'Comunicado';
        document.getElementById('f-preview-category').textContent = catLabel;
        document.getElementById('f-preview-title').textContent = title || 'Título da mensagem';
        var sub = document.getElementById('f-preview-subtitle');
        sub.textContent = subtitle;
        sub.style.display = subtitle ? 'block' : 'none';

        var body = document.getElementById('f-preview-body');
        // A prévia é só leitura: clona e remove script/handlers antes de injetar. O que
        // chega ao aplicativo passa pela sanitização do servidor de qualquer forma.
        var clone = document.createElement('div');
        clone.innerHTML = normalizedEditorHtml();
        clone.querySelectorAll('script,style,iframe,object,embed,link,meta').forEach(function (el) { el.remove(); });
        clone.querySelectorAll('*').forEach(function (el) {
          Array.prototype.slice.call(el.attributes).forEach(function (attr) {
            var name = attr.name.toLowerCase();
            if (name.indexOf('on') === 0 || name === 'style' || name === 'srcdoc') el.removeAttribute(attr.name);
            if ((name === 'href' || name === 'src') && /^\s*javascript:/i.test(attr.value)) el.removeAttribute(attr.name);
          });
        });
        body.replaceChildren.apply(body, Array.prototype.slice.call(clone.childNodes));
        var empty = document.getElementById('f-preview-empty');
        empty.style.display = (editor.textContent || '').trim() ? 'none' : 'block';
        updateCounters();
      }

      ['f-title', 'f-subtitle'].forEach(function (id) {
        document.getElementById(id).addEventListener('input', updatePreview);
      });
      document.getElementById('f-category').addEventListener('change', updatePreview);
      editor.addEventListener('input', updatePreview);

      // ─── Destinos ───
      document.getElementById('f-target-search').addEventListener('input', renderTargets);

      updateCounters();
      updatePreview();
      renderTargets();
    })();

    async function save() {
      clearError();
      var title = document.getElementById('f-title').value.trim();
      if (title.length < 2) { showError('Informe o título da mensagem.'); return; }
      var targetAll = document.getElementById('f-all').checked;
      var targets = Object.keys(selectedTargets);
      if (!targetAll && !targets.length) { showError('Escolha ao menos uma empresa ou marque "todas".'); return; }

      var payload = {
        uuid: MSG ? MSG.uuid : undefined,
        title: title,
        subtitle: document.getElementById('f-subtitle').value,
        category: document.getElementById('f-category').value,
        bodyHtml: normalizedEditorHtml(),
        urgent: document.getElementById('f-urgent').checked,
        targetAll: targetAll,
        targets: targets,
        imageBase64: imageData || undefined,
        removeImage: document.getElementById('f-remove-image').checked,
      };
      var btn = document.getElementById('f-save');
      btn.disabled = true;
      var original = btn.textContent;
      btn.textContent = 'Salvando…';
      try {
        var r = await fetch('/admin/messages/save', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
        });
        var d = await r.json().catch(function () { return {}; });
        if (!r.ok) { showError(d.error || 'Não foi possível salvar.'); btn.disabled = false; btn.textContent = original; return; }
        location.href = '/admin/messages';
      } catch (e) {
        showError('Erro de conexão ao salvar.');
        btn.disabled = false;
        btn.textContent = original;
      }
    }
  </script>
</body>
</html>
